# --- DB接続（Docker の postgres と一致させる。本番はサーバのPG情報に差し替え） ---
PGHOST=localhost
PGPORT=5432
PGUSER=mop
PGPASSWORD=mop_local_pw
PGDATABASE=mop

# --- 取込元CSVフォルダ（本番は共有フォルダのパスに差し替え） ---
# 既定はリポジトリ同梱の sample-data（自己完結。すぐ動く）
# 本番は共有フォルダの実パスに変更する
CSV_DIR=./sample-data

# --- 基準日(as-of)。本番は取込実行時刻。ここではサンプルデータの時期に合わせて固定 ---
AS_OF=2026-07-08

# --- 算出パラメータ（設計仕様書 2.7 / m_param 相当。将来はDBマスタ化） ---
SHOP_LT_DAYS=4
MILESTONE_LT_DAYS=5
STAGNANT_THRESHOLD=10

# --- 最終納期の採用元（設計仕様書4章の未決論点）---
# flexsche = FLEXSCHE JND(計算)の最終工程日（日粒度／既定）
# pbs      = PBS計画納期（月）を月末日として採用
DUE_SOURCE=flexsche

# --- サーバポート ---
API_PORT=8787
WEB_PORT=8080
