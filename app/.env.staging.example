# ============================================================
#  AWS 検証環境（Windows Server）用 .env サンプル
#  使い方: backend/.env にコピー
#    copy .env.staging.example backend\.env
#  setup-server.ps1 実行時は自動生成されます。
# ============================================================

# --- DB（同一 EC2 上の PostgreSQL）---
PGHOST=localhost
PGPORT=5432
PGUSER=mop
PGPASSWORD=CHANGE_ME
PGDATABASE=mop
DATABASE_URL=postgresql://mop:CHANGE_ME@localhost:5432/mop?schema=public

# --- CSV（検証用。本番は共有フォルダパス）---
CSV_DIR=C:/apps/mhi-app/data/csv

# --- 基準日 ---
# サンプルデータ検証時のみ有効化。本番では未設定（= 実行日）にすること。
# AS_OF=2026-07-08

# --- 算出パラメータ ---
SHOP_LT_DAYS=4
MILESTONE_LT_DAYS=5
STAGNANT_THRESHOLD=10
DUE_SOURCE=flexsche

# --- API ---
API_PORT=8787

# --- 認証（JWT / Cookie）---
# setup-server.ps1 が JWT_SECRET を自動生成します
JWT_SECRET=change-me-on-setup
# HTTPS 設定後は true に（Let's Encrypt / ACM 等）
COOKIE_SECURE=false
