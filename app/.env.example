# ============================================================
#  MHI 進捗管理支援システム 環境変数サンプル
#  使い方:
#    cd app && cp .env.example .env
#    cd backend && cp ../.env .env   # backend は実行ディレクトリの .env を読む
# ============================================================

# --- DB接続（Docker の postgres と一致。本番はサーバのPG情報に差し替え） ---
# 以下 PG* は psql 等の手動接続用。アプリ本体は DATABASE_URL のみ参照します。
PGHOST=localhost
PGPORT=5432
PGUSER=mop
PGPASSWORD=mop_local_pw
PGDATABASE=mop

# Prisma 用の接続文字列（上記と一致させること）
DATABASE_URL=postgresql://mop:mop_local_pw@localhost:5432/mop?schema=public

# --- 取込元CSVフォルダ（本番は共有フォルダのパスに差し替え） ---
# 既定はリポジトリ同梱の sample-data（自己完結・すぐ動く）
CSV_DIR=../sample-data

# --- 取込CSVファイル名（CSV_DIR 内。省略時は下記既定） ---
FILE_FLEXSCHE=FLEXSCHE結果出力5(残工程数見直し).csv
FILE_OCTOPUS=OCTPuS工程実績.csv
FILE_PBS=PBS部品計画納期リスト.csv
FILE_SHOP_MASTER=SHOP_JOBマスタ.csv

# --- 取込ジョブ状態ファイル（backend 実行ディレクトリからの相対パス） ---
INGEST_JOB_FILE=data/ingest-job.json

# --- 基準日(as-of)。本番は取込実行時刻。ここではサンプルデータの時期に合わせて固定 ---
AS_OF=2026-07-08

# --- 算出パラメータ（設計仕様書2.7 / m_param の既定。DBマスタ編集で上書き可） ---
SHOP_LT_DAYS=4
MILESTONE_LT_DAYS=5
STAGNANT_THRESHOLD=10

# --- 最終納期の採用元（未決論点。DBマスタ m_param.DUE_SOURCE で上書き可）---
# flexsche = FLEXSCHE JND(計算)の最終工程日（日粒度／既定）
# pbs      = PBS計画納期（月）を月末日として採用
DUE_SOURCE=flexsche

# --- サーバポート ---
API_PORT=8787

# --- CORS（開発時 Vite :5173 から API へアクセスする場合など） ---
# カンマ区切り。未設定時は http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- 認証（JWT / Cookie）---
# 本番は JWT_SECRET を十分に長いランダム値へ、COOKIE_SECURE=true（HTTPS配信）へ変更する
JWT_SECRET=mhi-dev-secret-change-me-for-local-only!!!
COOKIE_SECURE=false
